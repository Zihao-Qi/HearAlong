{
  "name": "hearalong",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "rehearse": "node --experimental-strip-types scripts/rehearse.ts",
    "check": "tsc --noEmit",
    "lint": "eslint public/ && sh scripts/lint-shell.sh",
    "checks": "sh scripts/run-checks.sh",
    "land": "node --experimental-strip-types scripts/land.ts",
    "delete-meetings": "node --experimental-strip-types scripts/delete-meetings.ts",
    "guard:install": "cd .. && common=$(git rev-parse --path-format=absolute --git-common-dir) && git config core.hooksPath \"${common%/*}/.githooks\"",
    "test": "node --experimental-strip-types --import ./scripts/check-isolation.ts --test test/*.test.ts",
    "smoke:stt": "node --experimental-strip-types scripts/stt-smoke.ts",
    "smoke:browser": "node --experimental-strip-types scripts/browser-smoke.ts",
    "build:app": "sh scripts/build-app.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "transcribe-cpp": "0.3.1",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3"
  }
}
